FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Run the crawler in 24/7 loop mode with fast settings: 50 workers, 0.3s delay,
# 200 pages/host, depth 4, 100k page budget per cycle.
CMD ["python", "-m", "serika", "loop", "--max-pages", "100000", "--max-depth", "4", "--per-host", "200", "--workers", "50", "--delay", "0.3", "--timeout", "12", "--rest-time", "60"]
