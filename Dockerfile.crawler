FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
# Run the crawler in 24/7 loop mode with fast settings: 200 workers, 0.2s delay,
# 200 pages/host, depth 4, 100k page budget per cycle.
# Uses urllib3 connection pooling + batch document upserts for max throughput.
CMD ["python", "-m", "serika", "loop", "--max-pages", "100000", "--max-depth", "4", "--per-host", "200", "--workers", "200", "--delay", "0.2", "--timeout", "8", "--rest-time", "60"]
